{
  "name": "Secret Santa",
  "short_name": "Santa",
  "description": "Draw names with couple exclusions, send private reveal links. No emails harvested, no ads.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fef6ea",
  "theme_color": "#aa3d59",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "id": "/secret-santa/",
  "lang": "en",
  "dir": "ltr",
  "orientation": "portrait-primary",
  "categories": [
    "entertainment",
    "social"
  ]
