{
  "name": "signup-sheets",
  "private": true,
  "description": "Engine 1, shared-link coordination. Skin A: signup sheets.",
  "type": "module",
  "scripts": {
    "test:helpers": "node test/helpers.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-signup \"node test/rules.test.mjs\"",
    "test:bracket-rules": "firebase emulators:exec --only firestore --project demo-signup \"node test/bracket-rules.test.mjs\"",
    "test:data": "firebase emulators:exec --only firestore,auth --project demo-signup \"node test/data.test.mjs\"",
    "test": "npm run test:helpers && npm run test:rules && npm run test:bracket-rules && npm run test:data",
    "dev": "firebase emulators:start --project demo-signup"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.17.1",
    "firebase-tools": "^15.26.0"
  }
}
