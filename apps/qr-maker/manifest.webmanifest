{
  "name": "QR Maker",
  "short_name": "QR Maker",
  "description": "Permanent QR codes for links, WiFi, phone and text. Made on your device, they never expire.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3faf2",
  "theme_color": "#367b30",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "id": "/qr-maker/",
  "lang": "en",
  "dir": "ltr",
  "orientation": "portrait-primary",
  "categories": [
    "utilities",
    "productivity"
  ]
}
