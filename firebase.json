{
  "hosting": {
    "public": "apps",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "**/marketing/**",
      "**/test/**",
      "**/*.md",
      "**/package.json",
      "**/package-lock.json",
      "**/firestore.rules",
      "**/firebase.json"
    ],
    "headers": [
      {
        "source": "**/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/manifest.webmanifest",
        "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
      }
    ]
  }
}
